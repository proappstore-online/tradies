{
  "name": "tradies",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @tradies/web dev",
    "prebuild": "npx -y @proappstore/cli@latest check",
    "build": "pnpm --filter @tradies/web build",
    "preview": "pnpm --filter @tradies/web preview",
    "lint": "echo 'Lint configured per app; extend lintstagedrc.json with eslint/prettier'",
    "typecheck": "pnpm --filter @tradies/web exec tsc -b",
    "test": "pnpm --filter @tradies/web exec tsc -b && node --no-warnings qa/actions.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.12"
  }
}
